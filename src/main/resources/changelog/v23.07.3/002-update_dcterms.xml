<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="addColumnDataTypeDCterms" author="Miled">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="thesaurus_dcterms" columnName="data_type"/>
            </not>
        </preConditions>
        <addColumn tableName="concept_dcterms">
          <column name="data_type" type="character varying"/>
        </addColumn> 
        <addColumn tableName="thesaurus_dcterms">
          <column name="data_type" type="character varying"/>
        </addColumn>                
    </changeSet>
</databaseChangeLog>
