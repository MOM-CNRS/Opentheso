# Copy to docker/.env before the first `docker compose up`.
# Compose picks up docker/.env automatically; docker/.env is gitignored.
#
# Same list feeds a k8s deployment:
#   kubectl create secret generic opentheso --from-env-file=docker/.env

DB_HOST=opentheso-db
DB_PORT=5432
DB_NAME=opentheso
DB_USER=opentheso
DB_PASSWORD=opentheso

# 32 characters exactly. Throwaway values for local evaluation.
# Generate real ones for anything reachable by others: openssl rand -hex 16
CRYPTO_KEY=01234567890123456789012345678901
CRYPTO_OPENARK_KEY=01234567890123456789012345678901

# host port only; the container always listens on 8099
APP_PORT=8099

# Import sizing. The parsed SKOS document is held in the HTTP session from upload until
# the import finishes, so a large vocabulary is a heap question, not a disk one.
# The JDK default is 25% of the container limit -- raise it before importing one.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
MAX_UPLOAD_SIZE=100MB

# Accounts created by `make seed-users` (not applied automatically).
# Passwords are stored as MD5 and upgraded to BCrypt on first login.
# Mail is derived as <username>@localhost: the column is NOT NULL + UNIQUE and
# is only an alternate login identifier, so it needs no knob of its own.
SEED_PROJECT=Evaluation
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin000
SEED_PROJECT_ADMIN_USER=projectadmin
SEED_PROJECT_ADMIN_PASSWORD=projectadmin
SEED_MANAGER_USER=manager
SEED_MANAGER_PASSWORD=manager
SEED_CONTRIBUTOR_USER=contributor
SEED_CONTRIBUTOR_PASSWORD=contributor
