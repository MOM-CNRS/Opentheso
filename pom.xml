        <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- Couverture Sonar : couche métier V2 (service/policy/mapper/repository).
             sonar.coverage.inclusions n'est pas appliqué par le scanner ; on exclut UI/moteurs/IO. -->
        <sonar.coverage.exclusions>**/AlignmentPropositionEnricher.java,**/ConceptCorpusSearchService.java,**/ui/**,**/*Bean.java,**/*Engine.java,**/persistence/**,**/model/**,**/workshop/**,**/config/**,**/*Controller.java,**/edition/io/**,**/candidat/alignment/**</sonar.coverage.exclusions>
